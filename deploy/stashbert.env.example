# Konfiguration von StashBert (architecture.md 9.2).
# install.sh legt daraus /etc/stashbert/stashbert.env an, nur wenn die Datei
# noch fehlt. DATA_DIR setzt die systemd-Unit (/var/lib/stashbert).
# Nach Änderungen: systemctl restart stashbert

# HTTP-Port (1 bis 65535).
PORT=8080

# Kontakt für den User-Agent bei Anfragen an Open Food Facts, zum Beispiel
# eine E-Mail-Adresse. Leer bedeutet: keine Abfragen bei Open Food Facts,
# unbekannte Produkte bekommen nur einen Platzhalter.
OFF_CONTACT=

# Anzahl aufbewahrter täglicher Backups in DATA_DIR/backups (1 bis 365).
BACKUP_KEEP=14

# Log-Level: debug, info, warn oder error.
LOG_LEVEL=info

# MQTT und Home Assistant (docs/home-assistant.md, architecture.md 11).
# Broker, z. B. mqtt://192.168.1.10:1883 oder mqtts://broker.lan:8883.
# Leer bedeutet: ohne MQTT und ohne Home Assistant.
MQTT_URL=
# MQTT-Benutzer und Passwort für StashBert. Das Passwort erscheint nie im Log.
MQTT_USERNAME=
MQTT_PASSWORD=
# Client-ID; zwei laufende Instanzen brauchen verschiedene IDs.
MQTT_CLIENT_ID=stashbert
# Präfix aller Topics (a bis z, 0 bis 9 und _, höchstens 64 Zeichen).
MQTT_TOPIC_PREFIX=stashbert
# Gerät in Home Assistant per Discovery anmelden (true) oder abmelden (false).
MQTT_HA_DISCOVERY=true
# Discovery-Präfix von Home Assistant.
MQTT_HA_PREFIX=homeassistant
