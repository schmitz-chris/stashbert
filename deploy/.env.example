# Konfiguration von StashBert unter Docker Compose (architecture.md 9.2).
# Als .env neben compose.yaml ablegen. Nach Änderungen: docker compose up -d
#
# DATA_DIR und PORT gehören nicht in diese Datei: Die Daten liegen im Image
# fest unter /data (in compose.yaml nach ./data eingebunden), und im Container
# lauscht StashBert auf dem Standardport 8080. Einen anderen Port auf dem
# Host stellt man in compose.yaml unter ports ein.

# Tag des Images ghcr.io/schmitz-chris/stashbert: eine Version ohne das
# führende v oder latest. Ein lokal gebautes Image: dev (docs/betrieb.md 13).
STASHBERT_VERSION=latest

# Kontakt für den User-Agent bei Anfragen an Open Food Facts, zum Beispiel
# eine E-Mail-Adresse. Leer bedeutet: keine Abfragen bei Open Food Facts,
# unbekannte Produkte bekommen nur einen Platzhalter.
OFF_CONTACT=

# Anzahl aufbewahrter täglicher Backups in data/backups (1 bis 365).
BACKUP_KEEP=14

# Log-Level: debug, info, warn oder error.
LOG_LEVEL=info
